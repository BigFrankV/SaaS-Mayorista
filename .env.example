# Global
APP_NAME=saas-mayorista
TZ=America/Santiago

# PostgreSQL
POSTGRES_DB=mayorista_db
POSTGRES_USER=mayorista_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=pgadmin@mayorista.local
PGADMIN_DEFAULT_PASSWORD=

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bootstrap inicial (solo para dev)
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_TENANT_NAME=Distribuidora Demo
APP_BOOTSTRAP_TENANT_RUT=76123456-7
APP_BOOTSTRAP_TENANT_GIRO=Comercializacion de alimentos
APP_BOOTSTRAP_TENANT_ADDRESS=Casa matriz
APP_BOOTSTRAP_ADMIN_NAME=Administrador
APP_BOOTSTRAP_ADMIN_EMAIL=admin@mayorista.local
APP_BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
